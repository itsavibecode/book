{
  "name": "PhotoChop",
  "short_name": "PhotoChop",
  "description": "A browser image editor with layers, masks, selections and live effects. Nothing leaves your device.",
  "id": "/photochop/",
  "start_url": "/photochop/",
  "scope": "/photochop/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#19191c",
  "theme_color": "#202024",
  "orientation": "any",
  "categories": ["graphics", "photo", "productivity"],
  "icons": [
    { "src": "/photochop/favicon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "/photochop/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/photochop/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/photochop/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/photochop/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "New document", "url": "/photochop/?action=new" }
  ]
}
